                                :sha256 "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
               :files {}}
  :case/expected :reject}
 {:case/id :hara.package.case/catalog-digest-mismatch
  :case/type :schema-catalog-admission
  :case/input {:schema/catalog {:format "std.typed.catalog/1"
