{:spec/version "0.0.0-alpha"
 :spec/status :draft
 :syntax :edn
 :purpose :foundation-surface-control
 :source-material "specs/99-archive/planning/foundation/foundation.edn"
 :protocol-contract "specs/01-lang/001-language/draft/conformance/protocols.edn"
 :public-method-case-catalog "specs/01-lang/001-language/draft/conformance/protocol-method-cases.edn"

 ;; This is the editable control document for the public Foundation surface.
 ;; Runtime code and parity tests are downstream artifacts of accepted entries.
 :workflow
 {:authority :edit-this-file-first
  :downstream [:rust :truffle :hal-library :parity-tests :documentation]
  :implementation-gate :accepted-or-explicitly-selected-proposal}

 :namespace-policy
 {:status :accepted
  :startup-default-library-aliases
  {edn std.foundation.edn}
  :canonical-protocol-namespace "std.protocol.<ascii-lowercase-protocol-name>"
  :canonical-protocol-var "std.protocol.<ascii-lowercase-protocol-name>.<Protocol>/<Protocol>"
  :canonical-method-var "std.protocol.<ascii-lowercase-protocol-name>.<Protocol>/<method>"
  :global-protocol-alias "<Protocol>"
  :global-method-call "<Protocol>/<method>"
  :example {:canonical std.protocol.ifn.IFn/invoke
            :global IFn/invoke}
  :foundation-protocol-alias {:namespace std.foundation
                              :name "<Protocol>"
                              :loads-canonical-object true
                              :visibility :public}
  :protocol-method-global-availability
  {:default true
   :hidden []}

 :namespace-config
 {:set-global-alias
  {:value :unqualified-symbol
   :effect :global-namespace-alias
   :conflict :reject-atomically}
  :set-global
  {:value :vector-of-qualified-vars
   :protocol-shorthand "IColl/start-string"
   :canonical-var "std.protocol.icoll.IColl/start-string"
   :effect :global-terminal-name-import
   :whole-namespace false
   :local-only-vars false
   :conflict :reject-atomically}
  :operations [:override :only :blank :set-global-alias :set-global :role :rename]
  :intrinsics
  {:reserved-for [:native-types :runtime-symbols]
   :namespace-config false}
  :resource-order
  {:root ["std/foundation.hal" "std/foundation.hbx"]
   :children ["std/foundation/<name>.hal" "std/foundation/<name>.hbx"]
   :rule :root-before-child
   :cache-hit :refresh-foundation-visibility}}

 :placement-policy
 {:status :proposed
  :general-and-collection std.foundation
  :reference-compatibility std.foundation
  :domain-specific "std.foundation.<domain>"
  :context-domains [:context :pointer :space]
  :root-domains [:general :collection :hash :mutable :application]
  :close-function std.foundation/close!
  :hidden-protocols []
  :protocol-dispatch "available everywhere through <Protocol>/<method>"
  :no-reference-subnamespace true
  :examples [{:call IFn/invoke :foundation-wrapper nil}
             {:call IIter/iter :foundation-wrapper std.foundation/iter}
             {:call IReset/reset :foundation-wrapper std.foundation/reset!}]}

 :naming-policy
 {:status :accepted
  :predicate-suffix "?"
  :compatibility-bang-names [reset! swap! cas! close!]
  :protocol-method-bang-suffix false
  :new-public-bang-functions false
  :watch-functions [watch-add watch-remove watch-list]
  :mutable-functions [to-mutable to-persistent]}

 :reference-functions
 {:status :accepted
  :namespace std.foundation
  :functions
  [{:name reset!
    :kind :direct-interface-wrapper
    :protocol-method IReset/reset
    :clojure-equivalent clojure.core/reset!}
   {:name cas!
    :kind :direct-interface-wrapper
    :protocol-method ICas/cas
    :clojure-equivalent clojure.core/compare-and-set!}
   {:name swap!
    :kind :derived-protocol-function
    :protocol-methods [IDeref/deref ICas/cas]
    :clojure-equivalent clojure.core/swap!}
   {:name watch-add
    :kind :direct-interface-wrapper
    :protocol-method IWatch/watch-add
    :clojure-equivalent clojure.core/add-watch}
   {:name watch-remove
    :kind :direct-interface-wrapper
    :protocol-method IWatch/watch-remove
    :clojure-equivalent clojure.core/remove-watch}
   {:name watch-list
    :kind :direct-interface-wrapper
    :protocol-method IWatch/watch-list
    :clojure-equivalent clojure.core/get-watches}]
  :excluded [compare:set! compare-and-set! add-watch remove-watch get-watches]}

 :classification
 {:direct-interface-wrapper
  "A public HAL function whose implementation delegates directly to one protocol method."
  :derived-protocol-function
  "A public HAL function implemented in .hal by composing protocol methods."
  :protocol-dispatch-only
  "No duplicate Foundation wrapper is proposed; use <Protocol>/<method> explicitly."
  :hidden-runtime-interface
  "Retained for runtime implementation parity but absent from the public protocol and Foundation surfaces."
  :host-primitive
  "The smallest runtime operation that cannot reasonably be expressed in portable .hal."}

 :clojure-relations
 {:exact "Same public operation and materially matching semantics."
  :semantic "Equivalent intent, with HAL naming, arity, or protocol-dispatch differences."
  :approximate "Useful migration analogue but not a compatibility promise."
  :none "No canonical clojure.core equivalent is claimed."}

 :function-contracts
 {:hara-specific "specs/01-lang/001-language/draft/conformance/functions.edn"
  :clojure-inspired "specs/01-lang/001-language/draft/conformance/clojure-functions.edn"
  :rule
  "This grouped surface is the consolidated callable contract. The focused
   files retain per-function rationale, Clojure relations, and exclusions."}

 :function-surface
 {:status :accepted
  :implementation-policy
  {:default :portable-hal
   :host-primitives :only-when-portable-hal-cannot-express-the-operation
   :public-private-hal-helpers false}

  :root
  {:portable-hal
   [map-keys map-vals map-juxt filter-keys filter-vals sid
    map-indexed keep-indexed select-keys merge flatten
    min max min-key max-key rand-int rand-nth random-sample shuffle]
   :host-primitives
   [var-ns var-sym bound? unbound? regexp? seq? error? uuid load-string
    ex ex-info ex-message ex-cause ex-provenance ex-class ex-native-type
    abs acos acosh asin asinh atan atan2 atanh
    ceil cos cosh exp floor pow sin sinh sqrt tan tanh
    quot rem parse-long parse-double nan? infinite?
    bit-and bit-or bit-xor bit-not bit-and-not bit-clear bit-flip bit-set
    bit-shift-left bit-shift-right bit-test rand]
   :host-values [wrapped wrapped?]
   :constants [E PI]
   :pending
   [{:name ns+
     :reason :confirm-arity-and-namespace-composition-semantics}]}

  :libraries
  {:set
   {:namespace std.foundation
    :implementation :portable-hal
    :functions
    [union intersection difference select subset? superset?]}

   :str
   {:namespace std.foundation.string
    :call-prefix str
    :implementation :host-string-primitives-with-hal-wrappers
    :functions
    [length blank? includes? starts-with? ends-with? char-at slice
     index-of last-index-of join split split-lines repeat replace
     replace-first trim trim-left trim-right trim-newline upper lower
     capitalize decapitalize pad-left pad-right reverse escape
     encode-utf8 decode-utf8]}

   :bytes
   {:namespace std.foundation.bytes
    :call-prefix bytes
    :implementation :host-byte-primitives
    :functions [count get set copy slice u8 s8]}

   :pretty
   {:namespace std.foundation.pretty
    :call-prefix pretty
    :implementation :portable-structural-visitor-over-native-document
    :functions [canonical-printer pretty-printer format-doc-edn format-doc
                render write pprint-str pprint]}

   :edn
   {:namespace std.foundation.edn
    :call-prefix edn
    :implementation :portable-hal-over-native-reader
    :functions [read write pretty]}

   :json
   {:namespace std.foundation.json
    :call-prefix json
    :implementation :portable-hal-over-native-json
    :functions [read write pretty]}}

  :dynamic-context
  {:dynamic-vars [*ns*]
   :forms [binding set!]
